POSTGRES_PASSWORD=change-this-postgres-password
REDIS_PASSWORD=change-this-redis-password
CLICKHOUSE_PASSWORD=change-this-clickhouse-password
MINIO_ROOT_USER=iotadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_DR_ROOT_USER=iotdradmin
MINIO_DR_ROOT_PASSWORD=change-this-minio-dr-password
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=change-this-emqx-dashboard-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
IOT_JWT_SECRET=change-this-to-at-least-32-random-characters
IOT_ADMIN_USER=admin
IOT_ADMIN_PASSWORD=change-this-admin-password
# 内置管理员可签发 Token 的租户白名单，逗号分隔
IOT_ADMIN_TENANTS=tenant_001
IOT_VIDEO_PLATFORM_SECRETS=video-platform-1:change-this-video-secret
IOT_VIDEO_MEDIA_ALLOWED_HOSTS=video.example.internal
# 浏览器视频预览使用精确 Origin 白名单（协议 + 主机 + 端口）
IOT_VIDEO_PREVIEW_ALLOWED_ORIGINS=https://video.example.internal
# Nginx CSP source列表使用空格分隔；HLS 主/子播放列表与分片 Origin 都要列出
IOT_VIDEO_PREVIEW_CSP_SOURCES=https://video.example.internal
IOT_OLLAMA_URL=
IOT_OLLAMA_MODEL=qwen3:8b
# 插件化 AI 运行时：disabled / ollama / deepseek / openai-compatible
IOT_AI_PROVIDER=
IOT_AI_BASE_URL=
IOT_AI_MODEL=
IOT_AI_API_KEY=
IOT_AI_PROVIDER_TEST_ALLOWED_ORIGINS=https://api.deepseek.com,http://localhost:11434,http://127.0.0.1:11434,http://[::1]:11434,http://ollama:11434
# AI 页面中 Ollama 沙箱的后端访问地址；Compose 使用 http://ollama:11434
IOT_AI_OLLAMA_URL=
# DeepSeek 也可使用官方变量名；IOT_AI_API_KEY 优先级更高
DEEPSEEK_API_KEY=
# DeepSeek Harness 源码侧车。使用 --profile harness 启动后填写内部地址。
IOT_AI_HARNESS_URL=
IOT_AI_HARNESS_TOKEN=change-this-harness-internal-token
IOT_AI_HARNESS_MCP_URL=http://platform-api:8080/mcp/harness
IOT_AI_HARNESS_MODEL=deepseek-v4-flash
IOT_AI_HARNESS_TIMEOUT=90s
IOT_WEAVIATE_URL=
IOT_BACKUP_ADMIN_TOKEN=change-this-backup-admin-token
IOT_BACKUP_INTERVAL=24h
IOT_BACKUP_INCREMENTAL_INTERVAL=15m
IOT_MQTT_WEBSOCKET_PUBLIC_URL=
IOT_THINGSPANEL_URL=
IOT_THINGSPANEL_USER=
IOT_THINGSPANEL_PASSWORD=
# 前后端分离端口与可选跨域白名单
IOT_WEB_PORT=8080
IOT_API_PORT=8081
IOT_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
